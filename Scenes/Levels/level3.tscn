[sub_resource type="GDScript" id="GDScript_jywle"]
script/source = "extends TileMapLayer

var tiles1 = [19, 6]
var tiles2 = [21, 9]


func open_wall():
	var tiles = []
	for i in range(tiles1[0], tiles2[0] + 1):
		for j in range(tiles1[1], tiles2[1] + 1):
			tiles.append(Vector2i(i, j))
			
	set_cells_terrain_connect(tiles, 0, -1)
"

