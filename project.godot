config_version=5

[application]

config/name="Just Jump"
run/main_scene="uid://cn1omgvwttgrp"
config/features=PackedStringArray("4.5", "Forward Plus")
run/max_fps=120
config/icon="uid://dvusbwysg54jh"

[autoload]

